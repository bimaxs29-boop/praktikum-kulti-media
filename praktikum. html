<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jelajah Wisata Indonesia</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Times New Roman", serif;
            background-color: white;
            color: #222;
        }

        .container {
            width: 85%;
            max-width: 1100px;
            margin: auto;
        }

        /* HEADER */
        header {
            background-color: #08dfe8;
            text-align: center;
            padding: 20px;
        }

        header h1 {
            margin: 0;
            font-size: 30px;
        }

        header p {
            margin-bottom: 0;
            font-size: 16px;
        }

        /* NAVIGASI */
        nav {
            display: flex;
            justify-content: space-around;
            background-color: #fff;
            border-bottom: 1px solid #ddd;
            padding: 8px 0;
        }

        nav a {
            text-decoration: none;
            color: #222;
            font-weight: bold;
        }

        nav a:hover {
            color: #00aeb5;
        }

        /* SECTION */
        section {
            text-align: center;
            padding: 25px 10px;
            border-bottom: 1px solid #ddd;
        }

        section h2 {
            font-size: 24px;
            margin-bottom: 10px;
        }

        section p {
            font-size: 16px;
            line-height: 1.5;
        }

        /* DESTINASI */
        .wisata-container {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-top: 20px;
        }

        .wisata {
            width: 33.33%;
        }

        .wisata img {
            width: 100%;
            height: 210px;
            object-fit: cover;
        }

        .wisata h3 {
            margin-bottom: 5px;
        }

        /* AUDIO */
        audio {
            margin-top: 10px;
        }

        /* VIDEO */
        video {
            width: 400px;
            max-width: 100%;
        }

        /* TABEL */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #555;
            padding: 10px;
            text-align: center;
        }

        th {
            background-color: #08dfe8;
        }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 15px;
            font-size: 14px;
        }

        /* RESPONSIVE */
        @media (max-width: 700px) {
            .wisata-container {
                flex-direction: column;
            }

            .wisata {
                width: 100%;
            }

            nav {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <!-- HEADER -->
    <header>
        <h1>JELAJAH WISATA INDONESIA</h1>
        <p>Temukan Keindahan Alam dan Budaya Indonesia</p>
    </header>

    <!-- NAVIGASI -->
    <nav>
        <a href="#beranda">Beranda</a>
        <a href="#wisata">Wisata</a>
        <a href="#galeri">Galeri</a>
    </nav>

    <!-- BERANDA -->
    <section id="beranda">
        <h2>🏠 Beranda</h2>

        <p>
            Selamat datang di website Jelajah Wisata Indonesia.
            Website ini berisi informasi mengenai beberapa tempat
            wisata menarik yang ada di Indonesia.
        </p>

        <p>
            Indonesia memiliki banyak sekali destinasi wisata mulai
            dari pegunungan, pantai, laut, hingga wisata budaya.
        </p>
    </section>

    <!-- DESTINASI WISATA -->
    <section id="wisata">
        <h2>🌍 Destinasi Wisata</h2>

        <p>
            Berikut adalah objek wisata menarik di Jawa Timur.
        </p>

        <div class="wisata-container">

            <!-- BROMO -->
            <div class="wisata">
                <img src="gunung bromo.jpg" alt="Gunung Bromo">

                <h3>Gunung Bromo</h3>

                <p>
                    Gunung Bromo merupakan salah satu tempat wisata
                    terkenal yang berada di Jawa Timur.
                </p>
            </div>

            <!-- IJEN -->
            <div class="wisata">
                <img src="kawah ijen.png" alt="Kawah Ijen">

                <h3>Kawah Ijen</h3>

                <p>
                    Kawah Ijen merupakan salah satu tempat wisata
                    terkenal yang berada di Jawa Timur.
                </p>
            </div>

            <!-- COBAN -->
            <div class="wisata">
                <img src="coban rondo.jpg" alt="Air Terjun Coban Rondo">

                <h3>Air Terjun Coban Rondo</h3>

                <p>
                    Air Terjun Coban Rondo merupakan salah satu
                    tempat wisata terkenal yang berada di Jawa Timur.
                </p>
            </div>

        </div>
    </section>

    <!-- MUSIK -->
    <section>
        <h2>🎵 Musik Nusantara</h2>

        <p>
            Silakan dengarkan musik berikut sambil menikmati
            informasi wisata Indonesia.
        </p>

        <audio controls>
            <source src="ampar ampar pisang. mp3" type="audio/mpeg">
            Browser Anda tidak mendukung audio.
        </audio>
    </section>

    <!-- VIDEO -->
    <section id="galeri">
        <h2>🎥 Wonderland Indonesia</h2>

        <p>
            Silakan nikmati video berikut sambil menikmati
            informasi wisata Indonesia.
        </p>

        <video controls>
            <source src="nusantara.mp4" type="video/mp4">
            Browser Anda tidak mendukung video.
        </video>
    </section>

    <!-- TABEL WISATA -->
    <section>
        <h2>📋 Tabel Data Wisata</h2>

        <table>
            <thead>
                <tr>
                    <th>No</th>
                    <th>Nama Wisata</th>
                    <th>Lokasi</th>
                    <th>Jenis Wisata</th>
                    <th>Keterangan</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>1</td>
                    <td>Gunung Bromo</td>
                    <td>Probolinggo</td>
                    <td>Pegunungan</td>
                    <td>Wisata alam terkenal</td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Kawah Ijen</td>
                    <td>Banyuwangi</td>
                    <td>Gunung</td>
                    <td>Memiliki kawah berwarna biru</td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>Air Terjun Coban Rondo</td>
                    <td>Malang</td>
                    <td>Air Terjun</td>
                    <td>Wisata alam yang indah</td>
                </tr>
            </tbody>
        </table>
    </section>

    <!-- FOOTER -->
    <footer>
        <p>
            Created By: Satria Bima
        </p>
    </footer>

</div>

</body>
</html>